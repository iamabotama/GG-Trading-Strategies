//@version=6
strategy("GG Key Open Strategy v2.4", overlay = true, max_boxes_count = 500, max_lines_count = 500, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = true, calc_on_every_tick = false)

// ╔══════════════════════════════════════════════════════╗
// ║ SECTION 1: INPUTS                                    ║
// ╚══════════════════════════════════════════════════════╝

// ── Ten Line (Key Open Level) ──
// v2.0: the line is an INTEREST POINT only — no direction/bias semantics.
grpTL     = "Ten Line"
tlColor   = input.color(color.yellow, "Line Color", group = grpTL)
tlWidth   = input.int(3, "Line Width", minval = 1, maxval = 10, group = grpTL)
tlStartH  = input.int(9,  "Span Start Hour (ET)",   minval = 0, maxval = 23, group = grpTL)
tlStartM  = input.int(30, "Span Start Minute (ET)", minval = 0, maxval = 59, group = grpTL, tooltip = "Default 9:30 ET = 6:30 AM Pacific.")
tlEndH    = input.int(0,  "Span End Hour (ET)",     minval = 0, maxval = 23, group = grpTL, tooltip = "If end is earlier than start it rolls to the next calendar day. Default 00:30 ET = 9:30 PM Pacific.")
tlEndM    = input.int(30, "Span End Minute (ET)",   minval = 0, maxval = 59, group = grpTL)

// ── EMA Bias (v2.1 — visuals match the user's "Adjustable EMA Cross") ──
grpMA      = "EMA Bias"
maShow     = input.bool(true, "Show EMAs", group = grpMA)
maFastLen  = input.int(9,  "Fast EMA Length", minval = 1, group = grpMA)
maSlowLen  = input.int(20, "Slow EMA Length", minval = 1, group = grpMA)
maFastCol  = input.color(color.maroon, "Fast EMA Color", group = grpMA)
maSlowCol  = input.color(color.black,  "Slow EMA Color", group = grpMA)
maWidth    = input.int(2, "EMA Line Width", minval = 1, maxval = 5, group = grpMA)
maShowX    = input.bool(true, "Show BUY / SELL Cross Labels", group = grpMA)
maBuyCol   = input.color(color.white, "Buy Label Color",  group = grpMA)
maSellCol  = input.color(color.white, "Sell Label Color", group = grpMA)
enEmaGate  = input.bool(true, "EMA Stack Gates Direction", group = grpMA, tooltip = "Shorts only when fast EMA is below slow EMA; longs only when fast is above slow. Toggle off to trade rejections in either direction.")

// ── Rejection Blocks (quality defaults per our definition) ──
grpRB         = "Rejection Blocks"
rbPivotLen    = input.int(3, "Swing Strength", minval = 1, maxval = 20, group = grpRB, tooltip = "Bars on each side to confirm a swing. 3 = quality mode. 1 = TakingProphets-style density.")
rbRequireDir  = input.bool(true, "Require Opposite-Direction Candle", group = grpRB, tooltip = "Bearish block only on a down-closing pivot candle; bullish block only on an up-closing one.")
rbRequireDisp = input.bool(true, "Require Displacement Confirmation", group = grpRB, tooltip = "Block only survives if price closes beyond the pivot candle's opposite extreme within the window.")
rbDispWindow  = input.int(3, "Displacement Window (bars)", minval = 1, maxval = 10, group = grpRB)
rbBullFill    = input.color(color.new(color.red, 80),  "Bullish Block Fill",   group = grpRB)
rbBullEdge    = input.color(color.red,                 "Bullish Block Border", group = grpRB)
rbBearFill    = input.color(color.new(color.gray, 80), "Bearish Block Fill",   group = grpRB)
rbBearEdge    = input.color(color.white,               "Bearish Block Border", group = grpRB)
rbShowMid     = input.bool(true, "Show 50% Midline", group = grpRB)
rbRemoveMit   = input.bool(true, "Delete Mitigated Blocks", group = grpRB)
rbMaxActive   = input.int(50, "Max Active Blocks per Side", minval = 1, maxval = 100, group = grpRB)

// ── Entry Triggers (Section 4) ──
grpEN        = "Entry Triggers"
enOn         = input.bool(true,  "Enable Entry Triggers", group = grpEN)
enRR         = input.float(5.0,  "Reward : Risk", minval = 0.5, step = 0.5, group = grpEN)
enTrigger    = input.string("Pre-Line Block + Bias", "Entry Trigger", options = ["Pre-Line Block + Bias", "EMA Bias (from Key Open)", "Line Rejection (legacy)"], group = grpEN, tooltip = "Pre-Line Block + Bias (v2.4 default): the day only trades if, when the 10:00 ET key open prints, an unmitigated rejection block ALREADY exists on the EMA bias side (9 < 20 needs a bearish block; 9 > 20 a bullish one). Entries fire in that direction while the bias holds; stop is snapshotted at that block's far edge; no qualifying block = no trades that day. In this mode the Stop Source input is ignored. EMA Bias: v2.3 behavior. Line Rejection: pre-v2.3 wick-touch behavior.")
enBlockTrig  = input.bool(true, "Also Trigger on New Rejection Block", group = grpEN, tooltip = "EMA Bias mode only: a rejection block confirming while the key open is live also fires an entry in the block's direction, independent of the EMA stack. Counts toward the daily cap.")
enStopSrc    = input.string("Swing High/Low", "Stop Source", options = ["Swing High/Low", "Rejection Block"], group = grpEN, tooltip = "Swing High/Low: last CONFIRMED swing (pivot, per Swing Strength) — short stop at last swing high, long stop at last swing low. Rejection Block: far edge of the most recent unmitigated same-side block.")
enMaxPerDay  = input.int(2, "Max Trades per Day", minval = 1, maxval = 10, group = grpEN)
enFlattenEOD = input.bool(true,  "Flatten Open Trade at Day Roll", group = grpEN, tooltip = "Closes any open position when the futures session rolls to a new day.")
enStrict     = input.bool(false, "Strict Rejection (must open on origin side)", group = grpEN, tooltip = "ON: candle must open below the line for a short (above for a long) — excludes break-and-fail candles. OFF: any touch that closes on the rejected side counts.")
enFallback   = input.bool(true,  "Fallback Stop: Rejection Wick", group = grpEN, tooltip = "When no valid rejection block exists, place the stop at the rejection candle's own wick extreme instead of skipping the trade.")
enShowRej    = input.bool(true,  "Mark All Line Rejections", group = grpEN, tooltip = "Small gray x on every line rejection, even when no trade fires — shows where the line was tested across history.")
enShowLines  = input.bool(true,  "Draw Stop / Target Lines", group = grpEN)
enStopColor  = input.color(color.orange, "Stop Line Color",   group = grpEN)
enTgtColor   = input.color(color.teal,   "Target Line Color", group = grpEN)

// ╔══════════════════════════════════════════════════════╗
// ║ SECTION 2: TEN LINE                                  ║
// ║ Level = OPEN of the 10:00 AM ET 5-minute candle.     ║
// ║ Drawn as ONE time-anchored line per day, created     ║
// ║ once and never modified — it cannot move, flicker,   ║
// ║ or shift on pan/resize/candle formation.             ║
// ╚══════════════════════════════════════════════════════╝

keyCalc() =>
    var float lvl = na
    if ta.change(time("D")) != 0
        lvl := na
    if hour(time, "America/New_York") == 10 and minute(time, "America/New_York") == 0 and barstate.isconfirmed
        lvl := open                            // v2.0: key open PRICE, no direction semantics
    lvl

keyLevel = request.security(syminfo.tickerid, "5", keyCalc(), lookahead = barmerge.lookahead_off)

// Create the day's line exactly once, the first bar the level prints.
// x1 anchors back to the session start time (before the key candle existed),
// which is why this must be a time-anchored line object — a plot cannot
// paint bars in the past.
if not na(keyLevel) and na(keyLevel[1])
    int yy = year(time, "America/New_York")
    int mm = month(time, "America/New_York")
    int dd = dayofmonth(time, "America/New_York")
    int x1 = timestamp("America/New_York", yy, mm, dd, tlStartH, tlStartM)
    int x2 = timestamp("America/New_York", yy, mm, dd, tlEndH, tlEndM)
    if x2 <= x1
        x2 += 24 * 60 * 60 * 1000              // end rolls to next calendar day
    line.new(x1, keyLevel, x2, keyLevel, xloc = xloc.bar_time, color = tlColor, width = tlWidth)

// ── EMAs (chart timeframe) — same math the gate uses, so labels and gate
// always agree. Cross labels mirror the standalone "Adjustable EMA Cross".
emaFast = ta.ema(close, maFastLen)
emaSlow = ta.ema(close, maSlowLen)
plot(maShow ? emaFast : na, title = "Fast EMA", color = maFastCol, linewidth = maWidth)
plot(maShow ? emaSlow : na, title = "Slow EMA", color = maSlowCol, linewidth = maWidth)

bool emaBuyX  = ta.crossover(emaFast, emaSlow)
bool emaSellX = ta.crossunder(emaFast, emaSlow)
plotshape(maShowX and emaBuyX,  title = "EMA Buy Signal",  style = shape.arrowup,   location = location.belowbar, color = maBuyCol,  textcolor = maBuyCol,  size = size.small, text = "BUY")
plotshape(maShowX and emaSellX, title = "EMA Sell Signal", style = shape.arrowdown, location = location.abovebar, color = maSellCol, textcolor = maSellCol, size = size.small, text = "SELL")

// ╔══════════════════════════════════════════════════════╗
// ║ SECTION 3: REJECTION BLOCKS — PIVOT-CANDLE ANCHOR    ║
// ║ Swing candle + wick + opposite-direction close +     ║
// ║ displacement = block. Each filter is toggleable.     ║
// ╚══════════════════════════════════════════════════════╝

// ── 3a. Candidate type ──
type Candidate
    bool  bearish
    float wickExtreme
    float bodyEdge
    float trigger
    int   anchorBar
    int   ttl

// ── 3b. Storage ──
var array<Candidate> pending = array.new<Candidate>()
var array<box>  bearBox = array.new_box()
var array<line> bearMid = array.new_line()
var array<box>  bullBox = array.new_box()
var array<line> bullMid = array.new_line()

newBlock(bool bearish, float wickExtreme, float bodyEdge, int anchorBar) =>
    float top  = bearish ? wickExtreme : bodyEdge
    float bot  = bearish ? bodyEdge : wickExtreme
    color edge = bearish ? rbBearEdge : rbBullEdge
    b = box.new(anchorBar, top, bar_index, bot, bgcolor = bearish ? rbBearFill : rbBullFill, border_color = edge, border_width = 1)
    m = line.new(anchorBar, (top + bot) / 2, bar_index, (top + bot) / 2, color = color.new(edge, rbShowMid ? 0 : 100), style = line.style_dashed)
    [b, m]

addBlock(bool bearish, float wickExtreme, float bodyEdge, int anchorBar) =>
    [b, m] = newBlock(bearish, wickExtreme, bodyEdge, anchorBar)
    if bearish
        array.push(bearBox, b)
        array.push(bearMid, m)
    else
        array.push(bullBox, b)
        array.push(bullMid, m)

// Per-bar flags: did a block CONFIRM on this bar? (v2.3 entry trigger)
// Plain bools reset every bar; set at global scope right where blocks are
// born, so no function-writes-global issue (see v1.7.1 / CE10088).
bool newBearBlkThisBar = false
bool newBullBlkThisBar = false

// ── 3c. Confirm or expire pending candidates ──
if barstate.isconfirmed and array.size(pending) > 0
    for i = array.size(pending) - 1 to 0
        Candidate c = array.get(pending, i)
        bool dispConfirmed = c.bearish ? close < c.trigger : close > c.trigger
        if dispConfirmed
            addBlock(c.bearish, c.wickExtreme, c.bodyEdge, c.anchorBar)
            if c.bearish
                newBearBlkThisBar := true
            else
                newBullBlkThisBar := true
            array.remove(pending, i)
        else
            c.ttl := c.ttl - 1
            if c.ttl <= 0
                array.remove(pending, i)

// ── 3d. Detect swings; apply direction + wick filters ──
ph = ta.pivothigh(rbPivotLen, rbPivotLen)
pl = ta.pivotlow(rbPivotLen, rbPivotLen)

// Last CONFIRMED swing levels (v2.2) — shared structural definition with the
// blocks (same Swing Strength). Non-repainting: updates only when the pivot
// confirms, rbPivotLen bars after the extreme prints.
var float lastSwingHi = na
var float lastSwingLo = na
if barstate.isconfirmed and not na(ph)
    lastSwingHi := ph
if barstate.isconfirmed and not na(pl)
    lastSwingLo := pl

if barstate.isconfirmed
    // Bearish RB: swing high candle, upper wick, closed down (if required)
    if not na(ph)
        float pOpen  = open[rbPivotLen]
        float pClose = close[rbPivotLen]
        float pTop   = math.max(pOpen, pClose)
        float pHigh  = high[rbPivotLen]
        float pLow   = low[rbPivotLen]
        bool  dirOk  = not rbRequireDir or pClose < pOpen
        if pHigh > pTop and dirOk
            if rbRequireDisp
                array.push(pending, Candidate.new(true, pHigh, pTop, pLow, bar_index - rbPivotLen, rbDispWindow))
            else
                addBlock(true, pHigh, pTop, bar_index - rbPivotLen)
                newBearBlkThisBar := true

    // Bullish RB: swing low candle, lower wick, closed up (if required)
    if not na(pl)
        float qOpen  = open[rbPivotLen]
        float qClose = close[rbPivotLen]
        float qBot   = math.min(qOpen, qClose)
        float qLo    = low[rbPivotLen]
        float qHi    = high[rbPivotLen]
        bool  dirOk2 = not rbRequireDir or qClose > qOpen
        if qLo < qBot and dirOk2
            if rbRequireDisp
                array.push(pending, Candidate.new(false, qLo, qBot, qHi, bar_index - rbPivotLen, rbDispWindow))
            else
                addBlock(false, qLo, qBot, bar_index - rbPivotLen)
                newBullBlkThisBar := true

// ── 3e. Extend active blocks, retire mitigated ones ──
manage(array<box> boxes, array<line> mids, bool bearish) =>
    if array.size(boxes) > 0
        for i = array.size(boxes) - 1 to 0
            box  b = array.get(boxes, i)
            line m = array.get(mids, i)
            box.set_right(b, bar_index)
            line.set_x2(m, bar_index)
            bool mitigated = bearish ? close > box.get_top(b) : close < box.get_bottom(b)
            if barstate.isconfirmed and mitigated
                if rbRemoveMit
                    box.delete(b)
                    line.delete(m)
                array.remove(boxes, i)
                array.remove(mids, i)
    while array.size(boxes) > rbMaxActive
        box.delete(array.shift(boxes))
        line.delete(array.shift(mids))

manage(bearBox, bearMid, true)
manage(bullBox, bullMid, false)

// ╔══════════════════════════════════════════════════════╗
// ║ SECTION 4: ENTRY TRIGGERS + SIMULATED ORDERS         ║
// ║ v2.3: key open live -> trade the EMA bias direction  ║
// ║ (or a fresh rejection block). One entry per bias     ║
// ║ state, re-armed only by a new EMA cross. Legacy      ║
// ║ line-touch rejection kept behind the Entry Trigger   ║
// ║ dropdown. Stop per Stop Source, else signal wick.    ║
// ╚══════════════════════════════════════════════════════╝

// ── 4a. Daily trade counter (rolls with the futures session, same as the level) ──
var int tradesToday = 0
bool newDay = ta.change(time("D")) != 0
if newDay
    tradesToday := 0

// ── 4b. Flatten at day roll (before any new entry logic runs) ──
if enFlattenEOD and newDay and strategy.position_size != 0
    strategy.close_all(comment = "Day roll")

// ── 4b-2. Day qualification (v2.4 "Pre-Line Block + Bias" mode) ──
// Decided ONCE per day, on the bar the key open prints (line birth):
//   bias short (9 < 20)  + an unmitigated bearish block exists -> day is short
//   bias long  (9 > 20)  + an unmitigated bullish block exists -> day is long
//   otherwise -> dayQualified stays false and NOTHING trades today.
// The stop is snapshotted here from the qualifying block's far edge, so the
// level survives even if the box is mitigated/deleted before trade 2.
// Section 3 runs above, so the arrays already reflect this bar's blocks with
// mitigated ones pruned.
bool preMode = enTrigger == "Pre-Line Block + Bias"
var bool  dayQualified = false
var bool  dayShort     = false
var float dayStopPx    = na
if newDay
    dayQualified := false
    dayShort     := false
    dayStopPx    := na

bool lineBorn = not na(keyLevel) and na(keyLevel[1])
if preMode and lineBorn and barstate.isconfirmed
    if emaFast < emaSlow and array.size(bearBox) > 0
        dayQualified := true
        dayShort     := true
        dayStopPx    := box.get_top(array.get(bearBox, array.size(bearBox) - 1))
    if emaFast > emaSlow and array.size(bullBox) > 0
        dayQualified := true
        dayShort     := false
        dayStopPx    := box.get_bottom(array.get(bullBox, array.size(bullBox) - 1))

// ── 4c. Stop lookup, per Stop Source input ──
// Swing High/Low: last confirmed pivot (short stop = last swing high,
//   long stop = last swing low).
// Rejection Block: far edge of the most recently created unmitigated
//   same-side block (Section 3e has already pruned mitigated ones this bar).
// Either way the price is snapshotted at entry, so later structure changes
// never move the stop of an open trade.
getStop(bool forShort) =>
    float s = na
    if preMode
        s := dayStopPx                         // v2.4: qualifying block's far edge, snapshotted at line birth
    else if enStopSrc == "Swing High/Low"
        s := forShort ? lastSwingHi : lastSwingLo
    else
        if forShort and array.size(bearBox) > 0
            s := box.get_top(array.get(bearBox, array.size(bearBox) - 1))
        if not forShort and array.size(bullBox) > 0
            s := box.get_bottom(array.get(bullBox, array.size(bullBox) - 1))
    s

// ── 4d. Entry signals, per Entry Trigger input ──
// Window is unchanged in both modes: live from the 10:00 ET key candle until
// the 18:00 ET session roll; the drawn line's longer visual span does not
// extend it.
bool lineActive = not na(keyLevel)

// Line rejections — still computed in every mode: the legacy trigger uses
// them, and the gray x markers stay useful for reading how the level traded.
bool rejShort   = lineActive and high >= keyLevel and close < keyLevel and (not enStrict or open < keyLevel)
bool rejLong    = lineActive and low  <= keyLevel and close > keyLevel and (not enStrict or open > keyLevel)

// EMA gate (legacy mode only — in EMA Bias mode the stack IS the trigger)
bool gateShort = not enEmaGate or emaFast < emaSlow
bool gateLong  = not enEmaGate or emaFast > emaSlow

// v2.3 EMA Bias mode: one shot per direction per bias state. Both directions
// arm at the day roll; firing consumes the direction; only a FRESH cross back
// into that direction re-arms it. This is what keeps it to a couple of
// deliberate trades instead of re-entering every bar the stack stays bearish.
var bool shortArmed = false
var bool longArmed  = false
if newDay
    shortArmed := true
    longArmed  := true
if emaSellX
    shortArmed := true
if emaBuyX
    longArmed := true

bool emaMode      = enTrigger == "EMA Bias (from Key Open)"
bool biasShortSig = lineActive and emaFast < emaSlow and shortArmed
bool biasLongSig  = lineActive and emaFast > emaSlow and longArmed
bool blkShortSig  = enBlockTrig and lineActive and newBearBlkThisBar
bool blkLongSig   = enBlockTrig and lineActive and newBullBlkThisBar

// v2.4 pre-line mode: qualified day + window live + EMA stack still on the
// day's side. Fires on the qualification bar itself (trade 1 at the key-open
// close) and again when flat (trade 2), until the daily cap says stop.
bool preShortSig = dayQualified and dayShort     and lineActive and emaFast < emaSlow
bool preLongSig  = dayQualified and not dayShort and lineActive and emaFast > emaSlow

bool sigShort = preMode ? preShortSig : emaMode ? (biasShortSig or blkShortSig) : (rejShort and gateShort)
bool sigLong  = preMode ? preLongSig  : emaMode ? (biasLongSig  or blkLongSig)  : (rejLong  and gateLong)

bool canEnter = enOn and barstate.isconfirmed and strategy.position_size == 0 and tradesToday < enMaxPerDay

// ── 4e. Trade state for drawings ──
var line stopLn = na
var line tgtLn  = na
bool firedShort = false
bool firedLong  = false

// Pine can't assign globals inside a function, so enterTrade RETURNS the
// stop/target lines and the caller assigns them at global scope.
enterTrade(bool isShort, float stopP) =>
    float entryP = close                       // market fill at this bar's close (process_orders_on_close)
    float risk   = math.abs(stopP - entryP)
    float tgtP   = isShort ? entryP - enRR * risk : entryP + enRR * risk
    string id    = isShort ? "Short" : "Long"
    strategy.entry(id, isShort ? strategy.short : strategy.long)
    strategy.exit(id + " X", from_entry = id, stop = stopP, limit = tgtP)
    line sL = enShowLines ? line.new(bar_index, stopP, bar_index + 1, stopP, color = enStopColor, width = 2) : na
    line tL = enShowLines ? line.new(bar_index, tgtP,  bar_index + 1, tgtP,  color = enTgtColor,  width = 2) : na
    [sL, tL]

if canEnter and sigShort
    float stopP = getStop(true)
    if (na(stopP) or stopP <= close) and enFallback
        stopP := high                          // fallback: signal candle's own wick extreme
    if not na(stopP) and stopP > close         // stop must sit above a short entry
        [sL, tL] = enterTrade(true, stopP)
        stopLn := sL
        tgtLn  := tL
        tradesToday += 1
        firedShort := true
        shortArmed := false

if canEnter and sigLong
    float stopP = getStop(false)
    if (na(stopP) or stopP >= close) and enFallback
        stopP := low                           // fallback: signal candle's own wick extreme
    if not na(stopP) and stopP < close         // stop must sit below a long entry
        [sL, tL] = enterTrade(false, stopP)
        stopLn := sL
        tgtLn  := tL
        tradesToday += 1
        firedLong := true
        longArmed := false

// ── 4f. Extend stop/target lines while the trade is open ──
if strategy.position_size != 0 and not na(stopLn)
    line.set_x2(stopLn, bar_index)
    line.set_x2(tgtLn,  bar_index)

plotshape(enShowRej and rejShort and barstate.isconfirmed, title = "Line Rejection (short side)", style = shape.xcross, location = location.abovebar, color = color.gray, size = size.tiny)
plotshape(enShowRej and rejLong  and barstate.isconfirmed, title = "Line Rejection (long side)",  style = shape.xcross, location = location.belowbar, color = color.gray, size = size.tiny)
plotshape(firedShort, title = "Short Entry", style = shape.triangledown, location = location.abovebar, color = color.black, size = size.small, text = "SHORT")
plotshape(firedLong,  title = "Long Entry",  style = shape.triangleup,   location = location.belowbar, color = color.red,   size = size.small, text = "LONG")
